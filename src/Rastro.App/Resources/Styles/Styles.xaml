<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource Canvas}" /></Style>
    <Style TargetType="Label"><Setter Property="FontFamily" Value="Manrope" /><Setter Property="FontSize" Value="13" /><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="LineBreakMode" Value="WordWrap" /></Style>
    <Style x:Key="MutedLabel" TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="12" /></Style>
    <Style x:Key="Eyebrow" TargetType="Label"><Setter Property="FontSize" Value="10" /><Setter Property="CharacterSpacing" Value="1.7" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="TextColor" Value="{StaticResource Muted}" /></Style>
    <Style x:Key="Heading" TargetType="Label"><Setter Property="FontSize" Value="28" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="CharacterSpacing" Value="-1" /></Style>
    <Style x:Key="SectionHeading" TargetType="Label"><Setter Property="FontSize" Value="19" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="CharacterSpacing" Value="-0.5" /></Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Manrope" /><Setter Property="FontSize" Value="12" /><Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" /><Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="18,10" /><Setter Property="BackgroundColor" Value="{StaticResource Accent}" /><Setter Property="TextColor" Value="White" />
        <Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="Opacity" Value="0.85" /></VisualState.Setters></VisualState>
            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="Opacity" Value="0.7" /></VisualState.Setters></VisualState>
            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateGroupList></Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="White" /><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="BorderColor" Value="{StaticResource Line}" /><Setter Property="BorderWidth" Value="1" /></Style>
    <Style x:Key="TextButton" TargetType="Button"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="TextColor" Value="{StaticResource Muted}" /><Setter Property="Padding" Value="8,8" /></Style>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="TextColor" Value="{StaticResource Muted}" /><Setter Property="HorizontalOptions" Value="Fill" /><Setter Property="ContentLayout" Value="Left,12" /><Setter Property="Padding" Value="16,12" /><Setter Property="HeightRequest" Value="48" /></Style>
    <Style x:Key="FilterButton" TargetType="Button"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="TextColor" Value="{StaticResource Muted}" /><Setter Property="Padding" Value="14,8" /><Setter Property="FontSize" Value="11" /><Setter Property="CornerRadius" Value="9" /></Style>
    <Style TargetType="Entry"><Setter Property="FontFamily" Value="Manrope" /><Setter Property="FontSize" Value="14" /><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="PlaceholderColor" Value="#89939C" /><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="MinimumHeightRequest" Value="48" /></Style>
    <Style TargetType="Border"><Setter Property="Stroke" Value="{StaticResource Line}" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="StrokeShape" Value="RoundRectangle 16" /><Setter Property="BackgroundColor" Value="White" /></Style>
    <Style TargetType="ActivityIndicator"><Setter Property="Color" Value="{StaticResource Accent}" /></Style>
    <Style TargetType="ProgressBar"><Setter Property="ProgressColor" Value="{StaticResource Accent}" /><Setter Property="BackgroundColor" Value="{StaticResource Line}" /><Setter Property="HeightRequest" Value="4" /></Style>
</ResourceDictionary>
