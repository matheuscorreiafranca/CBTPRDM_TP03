<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:Rastro.App.Controls" xmlns:vm="clr-namespace:Rastro.Core.ViewModels;assembly=Rastro.Core" xmlns:models="clr-namespace:Rastro.Core.Models;assembly=Rastro.Core" x:Class="Rastro.App.Views.ResultsPage" x:DataType="vm:TrackingViewModel" NavigationPage.HasNavigationBar="False" Title="Sua encomenda">
    <controls:WorkspaceView>
        <ScrollView>
            <VerticalStackLayout x:Name="PageContent" Padding="36,24,36,24" Spacing="22" MaximumWidthRequest="1260" HorizontalOptions="Fill">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Button Text="←  Todas as encomendas" Command="{Binding HomeCommand}" Style="{StaticResource TextButton}" HorizontalOptions="Start" FontSize="11" Padding="0" AutomationId="BackButton" /><Button Grid.Column="1" Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}" FontSize="10" AutomationId="SavePackageButton" /></Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout Spacing="7"><Label Text="Cada etapa da sua entrega." Style="{StaticResource Heading}" x:Name="PageHeading" /><HorizontalStackLayout Spacing="10"><Label Text="{Binding Package.Id}" FontSize="12" CharacterSpacing="1" TextColor="{StaticResource Muted}" VerticalOptions="Center" /><Button Text="Copiar código" Command="{Binding CopyCommand}" Style="{StaticResource TextButton}" FontSize="10" TextColor="{StaticResource Accent}" MinimumHeightRequest="44" Padding="4,0" AutomationId="CopyCodeButton" /></HorizontalStackLayout></VerticalStackLayout><Button x:Name="RefreshButton" Grid.Column="1" Text="↻  Atualizar" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsReady}" Style="{StaticResource SecondaryButton}" VerticalOptions="Center" FontSize="11" AutomationId="RefreshButton" /></Grid>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                <Border IsVisible="{Binding HasError}" BackgroundColor="#FFF0EC" Stroke="#F3D2C5" Padding="16,12"><Label Text="{Binding ErrorMessage}" TextColor="#A14125" FontSize="12" /></Border>
                <Border IsVisible="{Binding HasNotice}" BackgroundColor="#EAF4ED" Stroke="#D8E9DD" Padding="16,12" AutomationId="ResultNotice"><Label Text="{Binding Notice}" TextColor="#2F7051" FontSize="11" /></Border>

                <Border Padding="26" BackgroundColor="White" x:Name="StatusCard">
                    <VerticalStackLayout Spacing="22">
                        <Grid ColumnDefinitions="*,Auto" x:Name="StatusHeader" ColumnSpacing="20" RowDefinitions="Auto,Auto" RowSpacing="16">
                            <VerticalStackLayout Spacing="10"><Border BackgroundColor="{Binding Package.StatusBackground}" StrokeThickness="0" Padding="10,6" StrokeShape="RoundRectangle 7" HorizontalOptions="Start"><Label Text="{Binding Package.StatusLabel}" TextColor="{Binding Package.StatusColor}" FontSize="10" FontAttributes="Bold" /></Border><Label Text="{Binding Package.Headline}" FontSize="24" FontAttributes="Bold" CharacterSpacing="-0.7" x:Name="StatusHeadline" /><Label Text="{Binding Package.StatusDescription}" FontSize="11" TextColor="{StaticResource Muted}" MaximumWidthRequest="550" HorizontalOptions="Start" /></VerticalStackLayout>
                            <Border Grid.Column="1" x:Name="Eta" BackgroundColor="#F8F9FA" StrokeThickness="0" Padding="18,14" MinimumWidthRequest="175" VerticalOptions="Center"><VerticalStackLayout Spacing="6"><Label Text="{Binding Package.DeliveryLabel}" FontSize="10" TextColor="{StaticResource Muted}" /><Label Text="{Binding Package.DeliveryDate}" FontSize="20" FontAttributes="Bold" /><Label Text="{Binding Package.Destination}" FontSize="10" TextColor="{StaticResource Muted}" /></VerticalStackLayout></Border>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="9"><Border BackgroundColor="{StaticResource Accent}" StrokeThickness="0" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" HorizontalOptions="Start"><Label Text="✓" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" /></Border><Label Text="Postado" FontSize="10" FontAttributes="Bold" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="9" Opacity="0.35"><VerticalStackLayout.Triggers><DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Package.IsInTransit}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></VerticalStackLayout.Triggers><Border BackgroundColor="{StaticResource Accent}" StrokeThickness="0" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" HorizontalOptions="Start"><Label Text="2" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" /></Border><Label Text="Em trânsito" FontSize="10" FontAttributes="Bold" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="9" Opacity="0.35"><VerticalStackLayout.Triggers><DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Package.IsOutForDelivery}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></VerticalStackLayout.Triggers><Border BackgroundColor="{StaticResource Accent}" StrokeThickness="0" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" HorizontalOptions="Start"><Label Text="3" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" /></Border><Label Text="Em entrega" FontSize="10" FontAttributes="Bold" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="9" Opacity="0.35"><VerticalStackLayout.Triggers><DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Package.IsDelivered}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></VerticalStackLayout.Triggers><Border BackgroundColor="{StaticResource Accent}" StrokeThickness="0" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" HorizontalOptions="Start"><Label Text="4" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" /></Border><Label Text="Entregue" FontSize="10" FontAttributes="Bold" /></VerticalStackLayout>
                        </Grid>
                        <ProgressBar Progress="{Binding Package.Progress}" />
                    </VerticalStackLayout>
                </Border>

                <Grid x:Name="DetailsGrid" ColumnDefinitions="1.35*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="20">
                    <Border x:Name="TimelineCard" Padding="24">
                        <VerticalStackLayout Spacing="22">
                            <Grid ColumnDefinitions="*,Auto"><Label Text="A história do caminho" Style="{StaticResource SectionHeading}" FontSize="17" /><Image Grid.Column="1" Source="history.png" WidthRequest="20" HeightRequest="20" /></Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Package.Events}" Spacing="0">
                                <BindableLayout.ItemTemplate><DataTemplate x:DataType="models:TrackingEvent">
                                    <Grid ColumnDefinitions="48,22,*" ColumnSpacing="10" MinimumHeightRequest="97">
                                        <VerticalStackLayout Spacing="4"><Label Text="{Binding Day}" FontSize="10" FontAttributes="Bold" /><Label Text="{Binding Time}" FontSize="9" TextColor="{StaticResource Muted}" /></VerticalStackLayout>
                                        <Grid Grid.Column="1"><BoxView WidthRequest="1" Color="#EADBD2" HorizontalOptions="Center" Margin="0,12,0,0" /><Border WidthRequest="11" HeightRequest="11" Stroke="#D85B28" StrokeThickness="2" BackgroundColor="White" StrokeShape="RoundRectangle 6" VerticalOptions="Start" Margin="0,3,0,0" /></Grid>
                                        <VerticalStackLayout Grid.Column="2" Spacing="5" Padding="0,0,0,20"><Label Text="{Binding Title}" FontSize="11" FontAttributes="Bold" /><Label Text="{Binding Description}" FontSize="10" TextColor="{StaticResource Muted}" LineHeight="1.2" /><Label Text="{Binding Location}" FontSize="9" TextColor="#A4785F" /></VerticalStackLayout>
                                    </Grid>
                                </DataTemplate></BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="{Binding UpdatedLabel}" FontSize="9" TextColor="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" x:Name="RightColumn" Spacing="20">
                        <Border Padding="0"><VerticalStackLayout Spacing="0"><Grid HeightRequest="190" BackgroundColor="#F0F3ED"><Image Source="route_map.png" Aspect="AspectFill" /><Border Padding="8,4" Margin="12" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 6" HorizontalOptions="End" VerticalOptions="Start"><Label Text="ROTA ILUSTRATIVA" FontSize="8" CharacterSpacing="0.8" TextColor="{StaticResource Muted}" /></Border></Grid><VerticalStackLayout Padding="20" Spacing="9"><Label Text="ÚLTIMA LOCALIZAÇÃO" Style="{StaticResource Eyebrow}" FontSize="8" /><HorizontalStackLayout Spacing="7"><Image Source="pin.png" WidthRequest="16" HeightRequest="16" /><Label Text="{Binding Package.CurrentLocation}" FontSize="14" FontAttributes="Bold" /></HorizontalStackLayout><Label Text="A localização representa o último evento registrado." FontSize="9" TextColor="{StaticResource Muted}" /></VerticalStackLayout></VerticalStackLayout></Border>
                        <Border Padding="20"><VerticalStackLayout Spacing="17"><Label Text="Dentro dessa entrega" FontSize="15" FontAttributes="Bold" /><Grid ColumnDefinitions="32,*" ColumnSpacing="10"><Image Source="parcel.png" WidthRequest="30" HeightRequest="30" /><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="{Binding Package.Name}" FontSize="11" FontAttributes="Bold" /><Label Text="{Binding Package.Weight}" FontSize="10" TextColor="{StaticResource Muted}" /></VerticalStackLayout></Grid><BoxView HeightRequest="1" Color="{StaticResource Line}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="16"><VerticalStackLayout Spacing="5"><Label Text="Remetente" Style="{StaticResource MutedLabel}" FontSize="9" /><Label Text="{Binding Package.Sender}" FontSize="10" FontAttributes="Bold" /><Label Text="{Binding Package.Origin}" FontSize="9" TextColor="{StaticResource Muted}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="5"><Label Text="Destinatário" Style="{StaticResource MutedLabel}" FontSize="9" /><Label Text="{Binding Package.Recipient}" FontSize="10" FontAttributes="Bold" /><Label Text="{Binding Package.Destination}" FontSize="9" TextColor="{StaticResource Muted}" /></VerticalStackLayout><VerticalStackLayout Grid.Row="1" Spacing="5"><Label Text="Data de envio" Style="{StaticResource MutedLabel}" FontSize="9" /><Label Text="{Binding Package.ShippedDate}" FontSize="10" FontAttributes="Bold" /></VerticalStackLayout><VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5"><Label Text="{Binding Package.DeliveryLabel}" Style="{StaticResource MutedLabel}" FontSize="9" /><Label Text="{Binding Package.ExpectedDate}" FontSize="10" FontAttributes="Bold" /></VerticalStackLayout></Grid></VerticalStackLayout></Border>
                    </VerticalStackLayout>
                </Grid>
                <Border BackgroundColor="#EDF2F5" StrokeThickness="0" Padding="16,12"><HorizontalStackLayout Spacing="10"><Image Source="nav_help.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Start" /><Label Text="Um projeto para aprender, uma experiência para aproximar. Rastreamento demonstrativo com dados fictícios." FontSize="10" TextColor="#647685" HorizontalOptions="Fill" /></HorizontalStackLayout></Border>
                <Label Text="rastro.  /  cada etapa, mais perto." FontSize="9" TextColor="#8C969F" HorizontalOptions="End" />
            </VerticalStackLayout>
        </ScrollView>
    </controls:WorkspaceView>
</ContentPage>
